<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardBooking"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/success">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/txtBookingId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BK202510250336183363"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="BK202510250336183363" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Confirmed"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/success"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/rounded_background_success_light"
                tools:text="✓ Confirmed" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="12dp" />

        <!-- Booking Details -->
        <TextView
            android:id="@+id/txtCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Customer: 200128201391"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"
            tools:text="👤 Customer: 200128201391" />

        <TextView
            android:id="@+id/txtSlot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Slot 2"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"
            tools:text="⚡ Slot 2" />

        <TextView
            android:id="@+id/txtReservationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Scheduled: Oct 26, 2025 09:06 AM"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"
            tools:text="📅 Scheduled: Oct 26, 2025 09:06 AM" />

        <TextView
            android:id="@+id/txtDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️ Duration: 2 hour(s)"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"
            tools:text="⏱️ Duration: 2 hour(s)" />

        <TextView
            android:id="@+id/txtArrivalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕒 Arrived: Oct 25, 2025 03:40 PM"
            android:textSize="14sp"
            android:textColor="@color/success"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            tools:text="🕒 Arrived: Oct 25, 2025 03:40 PM" />

        <!-- Complete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complete Charging"
            android:textColor="@color/white"
            app:backgroundTint="@color/success"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/white"
            app:cornerRadius="8dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
