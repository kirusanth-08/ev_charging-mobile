<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardBooking"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/warning">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/txtBookingId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BK202510061316251216"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="BK202510061316251216" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Pending"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/warning"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/rounded_background_warning_light"
                tools:text="⏳ Pending" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="12dp" />

        <!-- Booking Details -->
        <TextView
            android:id="@+id/txtCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Customer: 200122401971"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"
            tools:text="👤 Customer: 200122401971" />

        <TextView
            android:id="@+id/txtSlot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Slot 1"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"
            tools:text="⚡ Slot 1" />

        <TextView
            android:id="@+id/txtReservationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Scheduled: Oct 08, 2025 01:18 PM"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"
            tools:text="📅 Scheduled: Oct 08, 2025 01:18 PM" />

        <TextView
            android:id="@+id/txtDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️ Duration: 1 hour(s)"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"
            tools:text="⏱️ Duration: 1 hour(s)" />

        <TextView
            android:id="@+id/txtTimeUntil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Past due"
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="@color/error"
            android:layout_marginBottom="12dp"
            tools:text="Past due" />

        <!-- Approve Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApprove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Approve Booking"
            android:textColor="@android:color/white"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconTint="@android:color/white"
            app:backgroundTint="@color/warning"
            app:cornerRadius="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
